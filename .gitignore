secrets.yaml
secrets.yml
*.pem
*.key

# Home Assistant runtime state and household configuration
/ha-config/
/homeassistant-config/
.storage/
configuration.yaml
home-assistant.log*
home-assistant_v2.db*
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Private project material: never commit to either remote
/local/
/private/
/backups/
/reports/
/logs/
/evidence/
*.log
*.bak

# Editor and OS temporary files
*.swp
*.swo
*~
.DS_Store
