    "step": {
      "user": {
        "title": "Solarman Azzurro — local",
        "description": "HYD HP / Sofar G3 profile. Local discovery suggests the logger IP and numeric serial; confirm or enter them manually. Port 8899 is a default. The supported profile is checked before saving.",
