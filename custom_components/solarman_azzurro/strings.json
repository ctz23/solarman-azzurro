      "full_interval_too_short": "Use an interval at least as long as the power interval."
    },
    "abort": {
      "already_configured": "This logger is already configured. Use Reconfigure to update its host or port.",
      "reconfigure_successful": "Connection updated and integration reloaded."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Local polling",
        "data": {
          "scan_interval": "Power and battery interval (seconds)",
          "full_scan_interval": "Counters, events and other readings interval (seconds)"
        },
        "description": "Power and battery default to 10 seconds; other readings default to 30 seconds. Both accept 1–300 seconds. Other readings cannot use a shorter interval than power. Very short intervals may cause timeouts or reconnections; increase them if errors occur."
