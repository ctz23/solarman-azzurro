          "name": "Device name",
          "host": "Local IP address",
          "logger_serial": "Numeric logger serial",
          "port": "TCP port",
          "scan_interval": "Power and battery interval (seconds)",
          "full_scan_interval": "Counters, events and other readings interval (seconds)"
        }
      },
      "select_logger": {
        "title": "Choose a logger",
